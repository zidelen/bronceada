<section class="brn-hero">
  <div class="brn-hero__panel">
    <img src="{{ 'polka-dot-halter-dress.jpg' | asset_url }}" alt="Polka dot halter dress – Bronceada" loading="eager" fetchpriority="high" width="900" height="1200">
    <div class="brn-hero__panel-overlay"></div>
  </div>

  <div class="brn-hero__panel">
    <img src="{{ 'white-eyelet-dress-austin.jpg' | asset_url }}" alt="White eyelet dress in downtown Austin – Bronceada" loading="eager" width="900" height="1200">
    <div class="brn-hero__panel-overlay"></div>
  </div>

  <div class="brn-hero__body">
    {% if section.settings.eyebrow != blank %}
      <span class="brn-hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="brn-hero__h1">{{ section.settings.heading | newline_to_br }}</h1>
    {% if section.settings.subheading != blank %}
      <p class="brn-hero__sub">{{ section.settings.subheading }}</p>
    {% endif %}
    <a href="{{ section.settings.button_url }}" class="brn-hero__btn">{{ section.settings.button_label }}</a>
  </div>
</section>

{% stylesheet %}
  .brn-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100vh;
    min-height: 580px;
    overflow: hidden;
    position: relative;
  }

  .brn-hero__panel {
    position: relative;
    overflow: hidden;
  }

  .brn-hero__panel img,
  .brn-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.6s ease;
    display: block;
  }

  .brn-hero__panel:hover img {
    transform: scale(1.03);
  }

  .brn-hero__panel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 6, 0, 0.62) 0%, rgba(20, 12, 0, 0.18) 55%);
    pointer-events: none;
  }

  .brn-hero__body {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    color: #fff;
    padding: 0 24px 200px;
    pointer-events: none;
  }

  .brn-hero__body a {
    pointer-events: auto;
  }

  .brn-hero__eyebrow {
    display: block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.88;
    margin-bottom: 16px;
  }

  .brn-hero__h1 {
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.0;
    margin-bottom: 18px;
  }

  .brn-hero__sub {
    font-size: 0.95rem;
    opacity: 0.88;
    margin-bottom: 30px;
    max-width: 380px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.65;
  }

  .brn-hero__btn {
    display: inline-block;
    background: #fff;
    color: #000;
    padding: 13px 34px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.2s, color 0.2s;
    text-decoration: none;
  }

  .brn-hero__btn:hover {
    background: #FFEF39;
    color: #000;
  }

  @media (max-width: 480px) {
    .brn-hero {
      grid-template-columns: 1fr;
      height: 100svh;
    }

    .brn-hero__panel:first-of-type {
      display: none;
    }

    .brn-hero__h1 {
      font-size: 2.1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Boutique · Austin, TX"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Effortless.\nElevated.\nAustin."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hand-picked one-of-a-kind pieces for the woman who wants to stand out."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
