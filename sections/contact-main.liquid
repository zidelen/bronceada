<section class="brn-con" style="--color-brand-teal: {{ section.settings.color_brand_teal }}; --color-brand-ink: {{ section.settings.color_brand_ink }}; --color-brand-cream: {{ section.settings.color_brand_cream }};">
  <div class="brn-con__inner">

    <div class="brn-con__info">
      <span class="brn-con__eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="brn-con__h1">{{ section.settings.heading }}</h1>
      <p class="brn-con__intro">{{ section.settings.intro }}</p>

      <div class="brn-con__block">
        <h3 class="brn-con__label">{{ section.settings.email_label }}</h3>
        <a href="mailto:{{ section.settings.email }}" class="brn-con__link">{{ section.settings.email }}</a>
      </div>

      <div class="brn-con__block">
        <h3 class="brn-con__label">{{ section.settings.visit_label }}</h3>
        <p class="brn-con__text">
          {{ section.settings.address | newline_to_br }}
        </p>
      </div>

      <div class="brn-con__block">
        <h3 class="brn-con__label">{{ section.settings.hours_label }}</h3>
        <ul class="brn-con__hours">
          <li><span>{{ section.settings.hours_1_day }}</span><span>{{ section.settings.hours_1_time }}</span></li>
          <li><span>{{ section.settings.hours_2_day }}</span><span>{{ section.settings.hours_2_time }}</span></li>
          <li><span>{{ section.settings.hours_3_day }}</span><span>{{ section.settings.hours_3_time }}</span></li>
        </ul>
      </div>

      <div class="brn-con__social">
        <a href="https://www.instagram.com/shopbronceada" class="brn-con__social-link" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM12 7a5 5 0 1 1 0 10A5 5 0 0 1 12 7zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
          Instagram
        </a>
        <a href="https://www.tiktok.com/@shopbronceada" class="brn-con__social-link" target="_blank" rel="noopener" aria-label="TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.78a4.84 4.84 0 0 1-1.01-.09z"/></svg>
          TikTok
        </a>
      </div>
    </div>

    <div class="brn-con__form">
      <div class="brn-con__form-inner">
        <h2 class="brn-con__form-heading">{{ section.settings.form_heading }}</h2>
        {% content_for 'blocks' %}
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
  .brn-con {
    padding: 72px 0 96px;
  }

  .brn-con__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 28px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: start;
  }

  .brn-con__eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brand-teal, #0A9CB5);
    margin-bottom: 12px;
  }

  .brn-con__h1 {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.05;
    margin: 0 0 20px;
  }

  .brn-con__intro {
    font-size: 0.94rem;
    line-height: 1.72;
    color: rgba(17, 17, 17, 0.55);
    margin: 0 0 40px;
    max-width: 380px;
  }

  .brn-con__block {
    margin-bottom: 28px;
  }

  .brn-con__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-ink, #111111);
    margin: 0 0 6px;
  }

  .brn-con__link {
    font-size: 0.92rem;
    color: var(--color-brand-teal, #0A9CB5);
    text-decoration: none;
  }

  .brn-con__link:hover {
    text-decoration: underline;
  }

  .brn-con__text {
    font-size: 0.92rem;
    line-height: 1.65;
    color: rgba(17, 17, 17, 0.65);
    margin: 0;
  }

  .brn-con__hours {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .brn-con__hours li {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    color: rgba(17, 17, 17, 0.65);
    max-width: 280px;
  }

  .brn-con__hours li span:first-child {
    color: var(--color-brand-ink, #111111);
    font-weight: 500;
  }

  .brn-con__social {
    display: flex;
    gap: 14px;
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid rgba(17, 17, 17, 0.1);
  }

  .brn-con__social-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-brand-ink, #111111);
    text-decoration: none;
    transition: color 0.2s;
  }

  .brn-con__social-link:hover {
    color: var(--color-brand-teal, #0A9CB5);
  }

  .brn-con__form-inner {
    background: var(--color-brand-cream, #FFFCEE);
    padding: 48px;
  }

  .brn-con__form-heading {
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 28px;
  }

  @media (max-width: 900px) {
    .brn-con__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .brn-con__intro {
      max-width: 100%;
    }
  }

  @media (max-width: 600px) {
    .brn-con__form-inner {
      padding: 28px 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact",
  "tag": "div",
  "class": "section-wrapper",
  "blocks": [
    { "type": "contact-form" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Get In Touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Have a question about your order, a product, or just want to say hi? Reach out and we'll get back to you within 24–48 business hours."
    },
    {
      "type": "header",
      "content": "Email"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Block label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "default": "reachbronceada@yahoo.com"
    },
    {
      "type": "header",
      "content": "Visit"
    },
    {
      "type": "text",
      "id": "visit_label",
      "label": "Block label",
      "default": "Visit Us"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "UL (Upper Level) &middot; Lakeline Mall\n11200 Lakeline Mall Dr\nCedar Park, TX 78613"
    },
    {
      "type": "header",
      "content": "Store hours"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Block label",
      "default": "Store Hours"
    },
    {
      "type": "text",
      "id": "hours_1_day",
      "label": "Hours row 1 – day(s)",
      "default": "Sunday"
    },
    {
      "type": "text",
      "id": "hours_1_time",
      "label": "Hours row 1 – time",
      "default": "12:00 PM &ndash; 6:00 PM"
    },
    {
      "type": "text",
      "id": "hours_2_day",
      "label": "Hours row 2 – day(s)",
      "default": "Mon &ndash; Thu"
    },
    {
      "type": "text",
      "id": "hours_2_time",
      "label": "Hours row 2 – time",
      "default": "11:00 AM &ndash; 8:00 PM"
    },
    {
      "type": "text",
      "id": "hours_3_day",
      "label": "Hours row 3 – day(s)",
      "default": "Fri &ndash; Sat"
    },
    {
      "type": "text",
      "id": "hours_3_time",
      "label": "Hours row 3 – time",
      "default": "10:00 AM &ndash; 9:00 PM"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Send Us a Message"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_brand_teal",
      "label": "Brand teal",
      "default": "#0A9CB5"
    },
    {
      "type": "color",
      "id": "color_brand_ink",
      "label": "Brand near-black (headings/text)",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "color_brand_cream",
      "label": "Brand cream (form background)",
      "default": "#FFFCEE"
    }
  ]
}
{% endschema %}
