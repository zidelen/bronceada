<section class="brn-cat">
  <div class="brn-cat__inner">
    <div class="brn-cat__header">
      <div>
        <span class="brn-cat__eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="brn-cat__heading">{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="brn-cat__grid" style="--columns: {{ section.settings.columns }}">
      {% for block in section.blocks %}
        {% assign col = block.settings.collection %}
        {% if block.settings.image != blank %}
          {% assign tile_img = block.settings.image %}
        {% elsif col != blank and col.featured_image != blank %}
          {% assign tile_img = col.featured_image %}
        {% else %}
          {% assign tile_img = null %}
        {% endif %}

        {% assign tile_label = block.settings.label %}
        {% if tile_label == blank and col != blank %}
          {% assign tile_label = col.title %}
        {% elsif tile_label == blank %}
          {% assign tile_label = 'Collection' %}
        {% endif %}

        {% if col != blank %}
          {% assign tile_url = col.url %}
        {% else %}
          {% assign tile_url = '#' %}
        {% endif %}

        <a
          href="{{ tile_url }}"
          class="brn-cat__tile"
          {{ block.shopify_attributes }}
        >
          {% if tile_img != null %}
            {{
              tile_img
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800',
                sizes: '(max-width: 768px) 50vw, 25vw',
                alt: tile_label
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'brn-cat__placeholder' }}
          {% endif %}
          <div class="brn-cat__overlay"></div>
          <div class="brn-cat__body">
            <span class="brn-cat__name">{{ tile_label }}</span>
            <span class="brn-cat__cta">{{ section.settings.cta_text }}</span>
          </div>
        </a>
      {% else %}
        <p class="brn-cat__empty">Add collection tiles in the theme editor.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .brn-cat {
    padding: 64px 0;
  }

  .brn-cat__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .brn-cat__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 36px;
  }

  .brn-cat__eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: #0A9CB5;
    margin-bottom: 7px;
  }

  .brn-cat__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111;
    margin: 0;
  }

  .brn-cat__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns, 4), 1fr);
    gap: 14px;
  }

  .brn-cat__tile {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    aspect-ratio: 3 / 4;
  }

  .brn-cat__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.6s ease;
  }

  .brn-cat__tile:hover img {
    transform: scale(1.06);
  }

  .brn-cat__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #f0f0f0;
  }

  .brn-cat__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 55%);
    pointer-events: none;
  }

  .brn-cat__body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #fff;
  }

  .brn-cat__name {
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .brn-cat__cta {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.55);
    padding-bottom: 1px;
  }

  .brn-cat__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: #999;
    padding: 48px 0;
  }

  @media (max-width: 768px) {
    .brn-cat {
      padding: 48px 0;
    }

    .brn-cat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category Grid",
  "tag": "div",
  "class": "section-wrapper",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Find Your Look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Tile CTA text",
      "default": "Shop Now"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "collection_tile",
      "name": "Collection tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Overrides the collection's featured image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label",
          "info": "Overrides the collection title shown on the tile"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        { "type": "collection_tile" },
        { "type": "collection_tile" },
        { "type": "collection_tile" },
        { "type": "collection_tile" }
      ]
    }
  ]
}
{% endschema %}
