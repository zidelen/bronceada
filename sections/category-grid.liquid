<section class="brn-cat">
  <div class="brn-cat__inner">
    <div class="brn-cat__header">
      <div>
        <span class="brn-cat__eyebrow">Find Your Look</span>
        <h2 class="brn-cat__heading">Shop by Category</h2>
      </div>
    </div>

    <div class="brn-cat__grid">

    <a href="{{ routes.root_url }}collections/dress-collection" class="brn-cat__tile">
      <img
        src="{{ 'Dresses.jpg' | asset_url }}"
        alt="Dresses – Bronceada"
        loading="lazy"
        width="800"
        height="1060"
      >
      <div class="brn-cat__overlay"></div>
      <div class="brn-cat__body">
        <span class="brn-cat__name">Dresses</span>
        <span class="brn-cat__cta">Shop Now</span>
      </div>
    </a>

    <a href="{{ routes.root_url }}collections/the-floral-collection" class="brn-cat__tile">
      <img
        src="{{ 'polka-dot-halter-dress.jpg' | asset_url }}"
        alt="Sets – Bronceada"
        loading="lazy"
        width="800"
        height="1060"
      >
      <div class="brn-cat__overlay"></div>
      <div class="brn-cat__body">
        <span class="brn-cat__name">Sets</span>
        <span class="brn-cat__cta">Shop Now</span>
      </div>
    </a>

    <a href="{{ routes.root_url }}collections/statement-summer-collection" class="brn-cat__tile">
      <img
        src="{{ 'Tops.jpg' | asset_url }}"
        alt="Tops & Basics – Bronceada"
        loading="lazy"
        width="800"
        height="1060"
      >
      <div class="brn-cat__overlay"></div>
      <div class="brn-cat__body">
        <span class="brn-cat__name">Tops &amp; Basics</span>
        <span class="brn-cat__cta">Shop Now</span>
      </div>
    </a>

    <a href="{{ routes.root_url }}collections/jewelry-collection" class="brn-cat__tile">
      <img
        src="{{ 'Jewlery.jpg' | asset_url }}"
        alt="Accessories – Bronceada"
        loading="lazy"
        width="800"
        height="1060"
      >
      <div class="brn-cat__overlay"></div>
      <div class="brn-cat__body">
        <span class="brn-cat__name">Accessories</span>
        <span class="brn-cat__cta">Shop Now</span>
      </div>
    </a>

    </div>
  </div>
</section>

{% stylesheet %}
  .brn-cat {
    padding: 64px 0;
  }

  .brn-cat__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .brn-cat__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 36px;
  }

  .brn-cat__eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: #0A9CB5;
    margin-bottom: 7px;
  }

  .brn-cat__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111;
    margin: 0;
  }

  .brn-cat__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .brn-cat__tile {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    aspect-ratio: 3 / 4;
  }

  .brn-cat__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.6s ease;
  }

  .brn-cat__tile:hover img {
    transform: scale(1.06);
  }

  .brn-cat__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 55%);
    pointer-events: none;
  }

  .brn-cat__body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #fff;
  }

  .brn-cat__name {
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .brn-cat__cta {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.55);
    padding-bottom: 1px;
  }

  @media (max-width: 768px) {
    .brn-cat {
      padding: 48px 0;
    }

    .brn-cat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category Grid",
  "tag": "div",
  "class": "section-wrapper",
  "settings": [],
  "presets": [
    {
      "name": "Category Grid"
    }
  ]
}
{% endschema %}
