{% liquid
  assign hero_url = 'lifestyle-beach-banner.jpg' | asset_url
%}

{%- comment -%} Hero {%- endcomment -%}
<div class="brn-about-hero" style="--about-hero-bg: url({{ hero_url }})">
  <div class="brn-about-hero__inner">
    <span class="brn-about-hero__eyebrow">About Bronceada</span>
    <h1 class="brn-about-hero__h1">Our Story</h1>
    <p class="brn-about-hero__sub">Hand-picked pieces. Austin roots. One-of-a-kind style.</p>
  </div>
</div>

{%- comment -%} Story – image left {%- endcomment -%}
<section class="brn-about-iwt">
  <div class="brn-about-iwt__img">
    <img
      src="{{ 'Dresses.jpg' | asset_url }}"
      alt="Curated dresses and women's clothing at Bronceada boutique – Cedar Park, TX"
      loading="lazy"
      width="900"
      height="900"
    >
  </div>
  <div class="brn-about-iwt__copy">
    <span class="brn-about-iwt__eyebrow">Who We Are</span>
    <h2 class="brn-about-iwt__h2">Born From a<br>Mother's Dream</h2>
    <p class="brn-about-iwt__body">Our story began with a shared passion for fashion that always bonded me and my mother together. Opening a clothing store had always been my mom's dream, but she sacrificed that dream to put her family first. Years later, I am proud to say we finally opened this store together.</p>
    <p class="brn-about-iwt__body">Through the amazing community we built on TikTok, we've been able to share our journey and connect with people who inspire us every day. Every piece in our collection is carefully sourced with the intention of creating a space where both mothers and daughters can shop together and find pieces they truly love.</p>
  </div>
</section>

{%- comment -%} Values strip {%- endcomment -%}
<section class="brn-about-vals">
  <div class="brn-about-vals__inner">
    <div class="brn-about-vals__item">
      <span class="brn-about-vals__icon">✦</span>
      <h3 class="brn-about-vals__h3">Hand-Picked</h3>
      <p class="brn-about-vals__text">Every item is personally selected. Nothing mass-produced, nothing you'll find everywhere else.</p>
    </div>
    <div class="brn-about-vals__item">
      <span class="brn-about-vals__icon">✦</span>
      <h3 class="brn-about-vals__h3">Austin-Rooted</h3>
      <p class="brn-about-vals__text">We're a local boutique with Cedar Park roots. Community is everything to us — we shop for our neighbors, not the algorithm.</p>
    </div>
    <div class="brn-about-vals__item">
      <span class="brn-about-vals__icon">✦</span>
      <h3 class="brn-about-vals__h3">One of a Kind</h3>
      <p class="brn-about-vals__text">Limited quantities, unique finds. When it's gone, it's gone — that's the point.</p>
    </div>
  </div>
</section>

{%- comment -%} Story – image right {%- endcomment -%}
<section class="brn-about-iwt brn-about-iwt--rev">
  <div class="brn-about-iwt__img">
    <img
      src="{{ 'Jewlery.jpg' | asset_url }}"
      alt="Bronceada jewelry and accessories"
      loading="lazy"
      width="900"
      height="900"
    >
  </div>
  <div class="brn-about-iwt__copy">
    <span class="brn-about-iwt__eyebrow">Our Promise</span>
    <h2 class="brn-about-iwt__h2">Curated With<br>Intention</h2>
    <p class="brn-about-iwt__body">We believe clothing is more than fashion — it's confidence, connection, and memories. Our hope is that every styling session and shopping trip becomes a special moment that strengthens bonds, builds confidence, and creates core memories that last forever.</p>
  </div>
</section>

{%- comment -%} Visit CTA {%- endcomment -%}
<section class="brn-about-visit">
  <div class="brn-about-visit__inner">
    <div class="brn-about-visit__copy">
      <span class="brn-about-visit__eyebrow">Find Us</span>
      <h2 class="brn-about-visit__h2">Come See Us<br>In Person</h2>
      <p class="brn-about-visit__text">The best way to experience Bronceada is in person. Stop by and see what's new — our inventory changes constantly.</p>
      <div class="brn-about-visit__details">
        <div>
          <p class="brn-about-visit__label">Location</p>
          <p class="brn-about-visit__info">UL (Upper Level) · Lakeline Mall<br>11200 Lakeline Mall Dr<br>Cedar Park, TX 78613</p>
        </div>
        <div>
          <p class="brn-about-visit__label">Hours</p>
          <ul class="brn-about-visit__hours">
            <li><span>Sunday</span><span>12:00 PM – 6:00 PM</span></li>
            <li><span>Mon – Thu</span><span>11:00 AM – 8:00 PM</span></li>
            <li><span>Fri – Sat</span><span>10:00 AM – 9:00 PM</span></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}

  /* ── Hero ── */
  .brn-about-hero {
    position: relative;
    background-image: var(--about-hero-bg);
    background-size: cover;
    background-position: center 40%;
    min-height: 320px;
    display: flex;
    align-items: center;
  }

  .brn-about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 5, 0, 0.55);
  }

  .brn-about-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 28px;
    text-align: center;
    width: 100%;
  }

  .brn-about-hero__eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FFEF39;
    margin-bottom: 14px;
  }

  .brn-about-hero__h1 {
    font-family: var(--font-heading--family);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1;
    color: #fff;
    margin: 0 0 18px;
  }

  .brn-about-hero__sub {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    letter-spacing: 0.04em;
  }

  /* ── Image With Text ── */
  .brn-about-iwt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 580px;
  }

  .brn-about-iwt--rev .brn-about-iwt__img { order: 2; }
  .brn-about-iwt--rev .brn-about-iwt__copy { order: 1; }

  .brn-about-iwt__img {
    overflow: hidden;
  }

  .brn-about-iwt__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .brn-about-iwt__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 80px;
    background: #FFFCEE;
  }

  .brn-about-iwt__eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0A9CB5;
    margin-bottom: 14px;
  }

  .brn-about-iwt__h2 {
    font-family: var(--font-heading--family);
    font-size: clamp(1.7rem, 3vw, 2.7rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.08;
    margin: 0 0 20px;
  }

  .brn-about-iwt__body {
    font-size: 0.94rem;
    line-height: 1.72;
    color: rgba(17, 17, 17, 0.6);
    margin: 0 0 14px;
    max-width: 440px;
  }

  .brn-about-iwt__body:last-child { margin-bottom: 0; }

  /* ── Values ── */
  .brn-about-vals {
    background: #111;
    padding: 72px 0;
  }

  .brn-about-vals__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 28px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  .brn-about-vals__item {
    text-align: center;
  }

  .brn-about-vals__icon {
    display: block;
    font-size: 1.2rem;
    color: #FFEF39;
    margin-bottom: 16px;
  }

  .brn-about-vals__h3 {
    font-family: var(--font-heading--family);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #fff;
    margin: 0 0 12px;
  }

  .brn-about-vals__text {
    font-size: 0.88rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  /* ── Visit CTA ── */
  .brn-about-visit {
    background: #fff;
    padding: 80px 0 96px;
  }

  .brn-about-visit__inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .brn-about-visit__eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0A9CB5;
    margin-bottom: 12px;
  }

  .brn-about-visit__h2 {
    font-family: var(--font-heading--family);
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.08;
    margin: 0 0 16px;
  }

  .brn-about-visit__text {
    font-size: 0.94rem;
    line-height: 1.72;
    color: rgba(17, 17, 17, 0.55);
    margin: 0 0 40px;
  }

  .brn-about-visit__details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding-top: 32px;
    border-top: 1px solid rgba(17, 17, 17, 0.1);
  }

  .brn-about-visit__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #111;
    margin: 0 0 8px;
  }

  .brn-about-visit__info {
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(17, 17, 17, 0.6);
    margin: 0;
  }

  .brn-about-visit__hours {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .brn-about-visit__hours li {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    color: rgba(17, 17, 17, 0.6);
  }

  .brn-about-visit__hours li span:first-child {
    font-weight: 500;
    color: #111;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .brn-about-iwt {
      grid-template-columns: 1fr;
    }

    .brn-about-iwt--rev .brn-about-iwt__img,
    .brn-about-iwt--rev .brn-about-iwt__copy {
      order: unset;
    }

    .brn-about-iwt__img {
      min-height: 340px;
    }

    .brn-about-iwt__copy {
      padding: 40px 24px;
    }

    .brn-about-iwt__body {
      max-width: 100%;
    }

    .brn-about-vals__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .brn-about-visit__details {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 600px) {
    .brn-about-hero {
      min-height: 340px;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "About",
  "tag": "div",
  "class": "section-wrapper",
  "settings": []
}
{% endschema %}
