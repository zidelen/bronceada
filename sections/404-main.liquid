<section class="brn-404">
  <div class="brn-404__inner">
    <span class="brn-404__eyebrow">Error</span>
    <p class="brn-404__number" aria-hidden="true">404</p>
    <h1 class="brn-404__h1">Page Not Found</h1>
    <p class="brn-404__body">Looks like this page took a day off. It may have moved, been removed, or never existed in the first place.</p>
    <div class="brn-404__actions">
      <a href="{{ routes.root_url }}" class="brn-404__btn brn-404__btn--solid">Back to Home</a>
      <a href="{{ routes.root_url }}collections/new-arrivals" class="brn-404__btn brn-404__btn--outline">Shop New Arrivals</a>
    </div>
  </div>
</section>

{% stylesheet %}
  .brn-404 {
    padding: 96px 0 80px;
    text-align: center;
    background: #fff;
  }

  .brn-404__inner {
    max-width: 580px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .brn-404__eyebrow {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #0A9CB5;
    margin-bottom: 12px;
  }

  .brn-404__number {
    font-family: var(--font-heading--family);
    font-size: clamp(7rem, 20vw, 14rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #FFEF39;
    margin: 0 0 -8px;
    user-select: none;
  }

  .brn-404__h1 {
    font-family: var(--font-heading--family);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.1;
    margin: 0 0 18px;
    color: #111;
  }

  .brn-404__body {
    font-size: 0.94rem;
    line-height: 1.72;
    color: rgba(17, 17, 17, 0.55);
    margin: 0 0 36px;
  }

  .brn-404__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .brn-404__btn {
    display: inline-flex;
    align-items: center;
    padding: 13px 28px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .brn-404__btn--solid {
    background: #000;
    color: #fff;
  }

  .brn-404__btn--solid:hover {
    background: #FFEF39;
    color: #000;
  }

  .brn-404__btn--outline {
    background: transparent;
    color: #000;
    border: 1.5px solid #000;
  }

  .brn-404__btn--outline:hover {
    background: #FFEF39;
    color: #000;
    border-color: #FFEF39;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "tag": "div",
  "class": "section-wrapper",
  "settings": []
}
{% endschema %}
