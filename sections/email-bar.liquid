{% comment %} <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bronceada | Boutique in Austin – Dresses, Sets &amp; Everyday Style</title>
  <meta name="description" content="Bronceada is an Austin boutique offering effortless dresses, elevated basics, sets, and statement pieces. Shop online or visit us in-store.">
  <meta property="og:title" content="Bronceada | Boutique in Austin">
  <meta property="og:description" content="Hand-picked one-of-a-kind pieces. Austin boutique in Lakeline Mall, Cedar Park.">
  <meta property="og:type" content="website">
  <link rel="preload" as="font" href="//bronceada.myshopify.com/cdn/fonts/geist/geist_n4.6e27f20c83b0a07405328f98ff3b0be957c5d6d5.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="//bronceada.myshopify.com/cdn/fonts/geist/geist_n7.d1a55eaf394973a6f8fe773d87de2e2f51331d2a.woff2" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="//bronceada.myshopify.com/cdn/fonts/chivo/chivo_n7.4d81c6f06c2ff78ed42169d6ec4aefa6d5cb0ff0.woff2" type="font/woff2" crossorigin>
  <style>
    @font-face {
      font-family: Geist;
      font-weight: 400;
      font-style: normal;
      font-display: swap;
      src: url("//bronceada.myshopify.com/cdn/fonts/geist/geist_n4.6e27f20c83b0a07405328f98ff3b0be957c5d6d5.woff2") format("woff2"),
           url("//bronceada.myshopify.com/cdn/fonts/geist/geist_n4.492f36219dd328eb9d6fa578986db9fe6d514f67.woff") format("woff");
    }
    @font-face {
      font-family: Geist;
      font-weight: 700;
      font-style: normal;
      font-display: swap;
      src: url("//bronceada.myshopify.com/cdn/fonts/geist/geist_n7.d1a55eaf394973a6f8fe773d87de2e2f51331d2a.woff2") format("woff2"),
           url("//bronceada.myshopify.com/cdn/fonts/geist/geist_n7.69b158278bc5ac2dd4016704355834ad3509f9f6.woff") format("woff");
    }
    @font-face {
      font-family: Chivo;
      font-weight: 700;
      font-style: normal;
      font-display: swap;
      src: url("//bronceada.myshopify.com/cdn/fonts/chivo/chivo_n7.4d81c6f06c2ff78ed42169d6ec4aefa6d5cb0ff0.woff2") format("woff2"),
           url("//bronceada.myshopify.com/cdn/fonts/chivo/chivo_n7.a0e879417e089c259360eefc0ac3a3c8ea4e2830.woff") format("woff");
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --color-primary: #FFEF39;
      --color-primary-dark: #E6D800;
      --color-sky: #88CDEA;
      --color-cyan: #77F8FF;
      --color-background: #FFFFFF;
      --color-text: #111111;
      --color-black: #000000;
      --color-white: #FFFFFF;
      --color-border: rgba(0,0,0,0.1);
      --color-footer-bg: #0E0E0E;
      --color-footer-text: #FFFFFF;
      --color-bg-secondary: #FFFCEE;
      --color-meta: rgba(17,17,17,0.55);
      --font-heading: 'Chivo', sans-serif;
      --font-body: 'Geist', sans-serif;
      --max-width: 1400px;
      --header-height: 80px;
    }

    html { font-size: 16px; scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      color: var(--color-text);
      background: var(--color-background);
      line-height: 1.5;
      overflow-x: hidden;
    }

    img { display: block; max-width: 100%; height: auto; }
    a { color: inherit; text-decoration: none; }
    button { cursor: pointer; border: none; background: none; font-family: inherit; }
    ul { list-style: none; }

    /* ── ANNOUNCEMENT BAR ── */
    .ann-bar {
      background: var(--color-sky);
      color: #000;
      padding: 0 20px;
      height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      letter-spacing: 0.04em;
      overflow: hidden;
      position: relative;
    }
    .ann-slide {
      position: absolute;
      width: 100%;
      text-align: center;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.5s ease, transform 0.5s ease;
      pointer-events: none;
    }
    .ann-slide.active {
      position: relative;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    /* ── HEADER ── */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--color-background);
      border-bottom: 1px solid var(--color-border);
      height: var(--header-height);
      display: flex;
      align-items: center;
      transition: box-shadow 0.3s ease;
    }
    .site-header.scrolled { box-shadow: 0 2px 16px rgba(0,0,0,0.07); }

    .hdr {
      max-width: var(--max-width);
      width: 100%;
      margin: 0 auto;
      padding: 0 28px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 16px;
    }
    .hdr-left { display: flex; align-items: center; }
    .hdr-center { display: flex; align-items: center; justify-content: center; }
    .hdr-right { display: flex; align-items: center; justify-content: flex-end; gap: 2px; }

    .logo {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 1.4rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-black);
    }

    .hdr-nav { display: flex; align-items: center; }
    .hdr-nav a {
      font-size: 0.785rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text);
      padding: 8px 12px;
      transition: color 0.2s;
      white-space: nowrap;
    }
    .hdr-nav a:hover { color: var(--color-primary); }

    .icon-btn {
      display: flex; align-items: center; justify-content: center;
      width: 40px; height: 40px;
      border-radius: 50%;
      transition: background 0.2s;
      color: var(--color-text);
    }
    .icon-btn:hover { background: rgba(0,0,0,0.05); }
    .icon-btn svg { width: 19px; height: 19px; }

    .menu-toggle { display: none; }

    /* Mobile nav */
    .mob-nav {
      display: none;
      position: fixed; inset: 0; z-index: 200;
      background: var(--color-background);
      flex-direction: column;
      padding: 80px 32px 40px;
      overflow-y: auto;
    }
    .mob-nav.open { display: flex; }
    .mob-nav-close {
      position: absolute; top: 22px; right: 22px;
      font-size: 1.5rem; line-height: 1;
      color: var(--color-text);
    }
    .mob-nav a {
      display: block;
      font-family: var(--font-heading);
      font-size: 1.4rem; font-weight: 700;
      letter-spacing: 0.05em; text-transform: uppercase;
      color: var(--color-text);
      padding: 16px 0;
      border-bottom: 1px solid var(--color-border);
    }

    /* ── HERO (split) ── */
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      height: 100vh;
      min-height: 580px;
      overflow: hidden;
      position: relative;
    }
    .hero__panel {
      position: relative;
      overflow: hidden;
    }
    .hero__panel img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center top;
      transition: transform 0.6s ease;
    }
    .hero__panel:hover img { transform: scale(1.03); }
    .hero__panel-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(10,6,0,0.62) 0%, rgba(20,12,0,0.18) 55%);
    }
    .hero__body {
      position: absolute; inset: 0; z-index: 2;
      display: flex; flex-direction: column;
      align-items: center; justify-content: flex-end;
      text-align: center; color: #fff;
      padding: 0 24px 200px;
      pointer-events: none;
    }
    .hero__body a { pointer-events: auto; }
    .hero__eyebrow {
      display: block;
      font-size: 0.78rem; font-weight: 500;
      letter-spacing: 0.22em; text-transform: uppercase;
      opacity: 0.88; margin-bottom: 16px;
    }
    .hero__h1 {
      font-family: var(--font-heading);
      font-size: clamp(2.5rem, 5.5vw, 4.5rem);
      font-weight: 700; letter-spacing: 0.02em;
      text-transform: uppercase; line-height: 1.0;
      margin-bottom: 18px;
    }
    .hero__sub {
      font-size: 0.95rem; opacity: 0.88;
      margin-bottom: 30px; max-width: 380px;
      margin-left: auto; margin-right: auto; line-height: 1.65;
    }
    .hero__btn {
      display: inline-block;
      background: #fff; color: #000;
      padding: 13px 34px;
      font-size: 0.78rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      transition: background 0.2s, color 0.2s;
    }
    .hero__btn:hover { background: var(--color-primary); color: #000; }

    /* ── BEACH BANNER ── */
    .beach-banner {
      width: 100%;
      height: 220px;
      overflow: hidden;
      position: relative;
    }
    .beach-banner img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center 60%;
    }

    /* ── SECTION BASE ── */
    .sec { padding: 64px 0; }
    .sec-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 28px; }

    .sec-hdr {
      display: flex; align-items: flex-end;
      justify-content: space-between; margin-bottom: 36px;
    }
    .eyebrow {
      display: block;
      font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.17em; text-transform: uppercase;
      color: #0A9CB5; margin-bottom: 7px;
    }
    .sec-h2 {
      font-family: var(--font-heading);
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.02em; line-height: 1.1;
    }
    .view-all {
      font-size: 0.78rem; font-weight: 600;
      letter-spacing: 0.1em; text-transform: uppercase;
      border-bottom: 1.5px solid var(--color-text);
      padding-bottom: 2px;
      transition: color 0.2s, border-color 0.2s;
      white-space: nowrap;
    }
    .view-all:hover { color: #0A9CB5; border-color: #0A9CB5; }

    /* ── PRODUCT GRID ── */
    .prod-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    .prod-card { position: relative; }
    .prod-card__img {
      position: relative; overflow: hidden;
      aspect-ratio: 3/4;
      background: var(--color-bg-secondary);
      margin-bottom: 13px;
    }
    .prod-card__img img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 0.55s ease;
    }
    .prod-card:hover .prod-card__img img { transform: scale(1.04); }

    .prod-badge {
      position: absolute; top: 12px; left: 12px;
      background: var(--color-primary); color: #000;
      font-size: 0.67rem; font-weight: 700;
      letter-spacing: 0.07em; text-transform: uppercase;
      padding: 4px 8px;
    }
    .prod-card__qa {
      position: absolute; bottom: 0; left: 0; right: 0;
      background: rgba(0,0,0,0.82); color: #fff;
      padding: 12px; text-align: center;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      opacity: 0; transform: translateY(8px);
      transition: opacity 0.22s ease, transform 0.22s ease;
    }
    .prod-card__img:hover .prod-card__qa { opacity: 1; transform: translateY(0); }

    .prod-title {
      font-size: 0.92rem; font-weight: 500;
      margin-bottom: 4px; color: var(--color-text);
    }
    .prod-price { font-size: 0.92rem; color: var(--color-meta); }

    /* ── COLLECTION TILES ── */
    .cat-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }
    .cat-tile {
      position: relative; overflow: hidden;
      aspect-ratio: 3/4; display: block;
    }
    .cat-tile img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }
    .cat-tile:hover img { transform: scale(1.06); }
    .cat-tile__ov {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 55%);
    }
    .cat-tile__txt {
      position: absolute; bottom: 0; left: 0; right: 0;
      padding: 22px 18px; color: #fff;
    }
    .cat-tile__name {
      font-family: var(--font-heading);
      font-size: 1.05rem; font-weight: 700;
      letter-spacing: 0.06em; text-transform: uppercase;
      margin-bottom: 7px;
    }
    .cat-tile__link {
      font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: #fff; border-bottom: 1px solid rgba(255,255,255,0.55);
      padding-bottom: 1px;
    }

    /* ── IMAGE WITH TEXT ── */
    .iwt {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 560px;
    }
    .iwt--rev .iwt-img { order: 2; }
    .iwt--rev .iwt-copy { order: 1; }
    .iwt-img { overflow: hidden; }
    .iwt-img img { width: 100%; height: 100%; object-fit: cover; }
    .iwt-copy {
      display: flex; flex-direction: column; justify-content: center;
      padding: 64px 80px;
      background: var(--color-bg-secondary);
    }
    .iwt-copy .eyebrow { margin-bottom: 14px; }
    .iwt-h2 {
      font-family: var(--font-heading);
      font-size: clamp(1.7rem, 3vw, 2.7rem);
      font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.02em; line-height: 1.08;
      margin-bottom: 18px;
    }
    .iwt-body {
      font-size: 0.94rem; line-height: 1.72;
      color: var(--color-meta); margin-bottom: 30px;
      max-width: 440px;
    }
    .btn-grp { display: flex; gap: 12px; flex-wrap: wrap; }

    .btn {
      display: inline-flex; align-items: center;
      padding: 13px 28px;
      font-size: 0.78rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .btn-blk { background: #000; color: #fff; }
    .btn-blk:hover { background: var(--color-primary); color: #000; }
    .btn-out { background: transparent; color: #000; border: 1.5px solid #000; }
    .btn-out:hover { background: var(--color-primary); color: #000; border-color: var(--color-primary); }

    /* ── SALES BANNER ── */
    .sale-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .sale-col {
      position: relative; overflow: hidden;
      min-height: 480px;
    }
    .sale-col img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 0.55s ease;
    }
    .sale-col:hover img { transform: scale(1.04); }
    .sale-ov {
      position: absolute; inset: 0;
      background: rgba(0,0,0,0.36);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      text-align: center; color: #fff; padding: 40px;
    }
    .sale-eyebrow {
      font-size: 0.72rem; font-weight: 500;
      letter-spacing: 0.2em; text-transform: uppercase;
      opacity: 0.82; margin-bottom: 12px;
    }
    .sale-h3 {
      font-family: var(--font-heading);
      font-size: clamp(1.5rem, 3vw, 2.5rem);
      font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.05em; line-height: 1.1; margin-bottom: 22px;
    }
    .sale-btn {
      display: inline-block;
      padding: 12px 28px;
      font-size: 0.75rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      background: #fff; color: #000;
      transition: background 0.2s, color 0.2s;
    }
    .sale-btn:hover { background: var(--color-primary); color: #000; }

    /* ── TESTIMONIALS ── */
    .testimonials {
      background: var(--color-bg-secondary);
      padding: 64px 0; text-align: center;
    }
    .test-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px; margin-top: 40px;
    }
    .test-card { background: #fff; padding: 32px 26px; }
    .test-stars { color: var(--color-primary); font-size: 1.05rem; letter-spacing: 2px; margin-bottom: 14px; }
    .test-text {
      font-size: 0.92rem; line-height: 1.72;
      color: var(--color-meta); font-style: italic; margin-bottom: 18px;
    }
    .test-author {
      font-size: 0.82rem; font-weight: 700;
      letter-spacing: 0.06em; text-transform: uppercase;
    }

    /* ── POLICY BAR ── */
    .policy-bar {
      padding: 44px 24px; text-align: center;
      border-top: 1px solid var(--color-border);
    }
    .policy-h3 {
      font-family: var(--font-heading);
      font-size: 1.2rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.05em;
      margin-bottom: 12px;
    }
    .policy-text {
      font-size: 0.9rem; line-height: 1.7; color: var(--color-meta);
      max-width: 700px; margin: 0 auto;
    }

    /* ── NEWSLETTER ── */
    .newsletter {
      background: #111; color: #fff;
      padding: 72px 24px; text-align: center;
    }
    .nl-h2 {
      font-family: var(--font-heading);
      font-size: clamp(1.7rem, 3vw, 2.5rem);
      font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.05em; margin-bottom: 10px;
    }
    .nl-sub {
      font-size: 0.94rem; opacity: 0.65;
      margin-bottom: 36px; max-width: 420px;
      margin-left: auto; margin-right: auto; line-height: 1.6;
    }
    .nl-form {
      display: flex; max-width: 460px; margin: 0 auto;
    }
    .nl-input {
      flex: 1; padding: 14px 18px;
      font-family: var(--font-body); font-size: 0.94rem;
      border: 1px solid rgba(255,255,255,0.28);
      background: rgba(255,255,255,0.07);
      color: #fff; outline: none;
      transition: border-color 0.2s;
    }
    .nl-input::placeholder { color: rgba(255,255,255,0.4); }
    .nl-input:focus { border-color: rgba(255,255,255,0.55); }
    .nl-btn {
      padding: 14px 26px;
      background: var(--color-primary); color: #000;
      font-family: var(--font-body); font-size: 0.78rem;
      font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      white-space: nowrap; transition: background 0.2s;
    }
    .nl-btn:hover { background: var(--color-primary-dark); color: #000; }
    .nl-disc { margin-top: 12px; font-size: 0.73rem; opacity: 0.42; }

    /* ── FOOTER ── */
    .site-footer {
      background-image: url('./imgs/lifestyle-beach-banner.jpg');
      background-size: cover;
      background-position: center 60%;
      position: relative;
      color: var(--color-footer-text);
      padding: 64px 0 32px;
    }
    .site-footer::before {
      content: '';
      position: absolute; inset: 0;
      background: rgba(8, 5, 0, 0.78);
    }
    .site-footer .ftr { position: relative; z-index: 1; }
    .ftr { max-width: var(--max-width); margin: 0 auto; padding: 0 28px; }
    .ftr-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr 1.2fr;
      gap: 48px; margin-bottom: 48px;
    }
    .ftr-logo {
      font-family: var(--font-heading);
      font-size: 1.4rem; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 14px;
    }
    .ftr-desc {
      font-size: 0.875rem; line-height: 1.65;
      color: rgba(255,255,255,0.55); max-width: 280px; margin-bottom: 22px;
    }
    .ftr-social { display: flex; gap: 10px; }
    .ftr-social a {
      display: flex; align-items: center; justify-content: center;
      width: 34px; height: 34px;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 50%; color: rgba(255,255,255,0.65);
      transition: border-color 0.2s, color 0.2s;
    }
    .ftr-social a:hover { border-color: var(--color-primary); color: var(--color-primary); background: rgba(255,239,57,0.08); }
    .ftr-social svg { width: 15px; height: 15px; }

    .ftr-col-h {
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.15em; text-transform: uppercase;
      color: var(--color-cyan);
      margin-bottom: 18px;
    }
    .ftr-links { display: flex; flex-direction: column; gap: 10px; }
    .ftr-links a {
      font-size: 0.875rem; color: rgba(255,255,255,0.55);
      transition: color 0.2s;
    }
    .ftr-links a:hover { color: #fff; }

    .ftr-bottom {
      border-top: 1px solid rgba(255,255,255,0.1);
      padding-top: 26px;
      display: flex; align-items: center;
      justify-content: space-between; flex-wrap: wrap; gap: 10px;
    }
    .ftr-copy { font-size: 0.8rem; color: rgba(255,255,255,0.38); }
    .ftr-legal { display: flex; gap: 22px; }
    .ftr-legal a { font-size: 0.8rem; color: rgba(255,255,255,0.38); transition: color 0.2s; }
    .ftr-legal a:hover { color: rgba(255,255,255,0.75); }

    /* ── RESPONSIVE ── */
    @media (max-width: 1100px) {
      .prod-grid { grid-template-columns: repeat(3, 1fr); }
      .ftr-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 768px) {
      :root { --header-height: 60px; }
      .hdr-nav { display: none; }
      .menu-toggle { display: flex; }
      .hdr { grid-template-columns: auto 1fr auto; }
      .hdr-center { justify-content: flex-start; padding-left: 12px; }
      .logo { font-size: 1.15rem; letter-spacing: 0.18em; }
      .prod-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
