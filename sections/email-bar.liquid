{% assign form_id = 'BronceadaEmailBar' %}

<section class="beb-newsletter">
  <div class="beb-inner">
    <h2 class="beb-h2">Get on the List</h2>
    <p class="beb-sub">Be the first to know about new arrivals, exclusive sales, and styling inspo — straight to your inbox.</p>

    {%- form 'customer', id: form_id -%}
      <input type="hidden" name="contact[id]" value="{{ form_id }}">
      <div class="beb-form">
        <input
          type="email"
          name="contact[email]"
          class="beb-input"
          placeholder="Your email address"
          aria-label="Email address"
          autocomplete="email"
          required
          {% if form.errors %}autofocus aria-invalid="true"{% endif %}
        >
        <button type="submit" class="beb-btn">Subscribe</button>
      </div>

      {%- if form.errors -%}
        <p class="beb-msg beb-msg--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <p class="beb-msg beb-msg--success">Thanks for subscribing!</p>
      {%- endif -%}
    {%- endform -%}

    <p class="beb-disc">By subscribing you agree to receive marketing emails. Unsubscribe anytime.</p>
  </div>
</section>

