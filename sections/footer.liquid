
{% liquid
  if section.settings.background_image
    assign bg_url = section.settings.background_image | image_url: width: 1920
  else
    assign bg_url = 'lifestyle-beach-banner.jpg' | asset_url
  endif

  assign shop_url_1 = section.settings.shop_link_1_url
  if shop_url_1 == blank
    assign shop_url_1 = routes.root_url | append: 'collections/new-arrivals'
  endif

  assign shop_url_2 = section.settings.shop_link_2_url
  if shop_url_2 == blank
    assign shop_url_2 = routes.root_url | append: 'collections/dress-collection'
  endif

  assign shop_url_3 = section.settings.shop_link_3_url
  if shop_url_3 == blank
    assign shop_url_3 = routes.root_url | append: 'collections/the-floral-collection'
  endif

  assign shop_url_4 = section.settings.shop_link_4_url
  if shop_url_4 == blank
    assign shop_url_4 = routes.root_url | append: 'collections/statement-summer-collection'
  endif

  assign shop_url_5 = section.settings.shop_link_5_url
  if shop_url_5 == blank
    assign shop_url_5 = routes.root_url | append: 'collections/jewelry-collection'
  endif

  assign help_url_1 = section.settings.help_link_1_url
  if help_url_1 == blank
    assign help_url_1 = routes.root_url | append: 'pages/about'
  endif

  assign help_url_2 = section.settings.help_link_2_url
  if help_url_2 == blank
    assign help_url_2 = routes.root_url | append: 'pages/contact'
  endif

  assign help_url_3 = section.settings.help_link_3_url
  if help_url_3 == blank
    assign help_url_3 = routes.root_url | append: 'pages/refunds'
  endif

  assign help_url_4 = section.settings.help_link_4_url
  if help_url_4 == blank
    assign help_url_4 = routes.root_url | append: 'pages/shipping'
  endif

  assign legal_url_1 = section.settings.legal_link_1_url
  if legal_url_1 == blank
    assign legal_url_1 = routes.root_url | append: 'policies/privacy-policy'
  endif

  assign legal_url_2 = section.settings.legal_link_2_url
  if legal_url_2 == blank
    assign legal_url_2 = routes.root_url | append: 'policies/terms-of-service'
  endif

  assign legal_url_3 = section.settings.legal_link_3_url
  if legal_url_3 == blank
    assign legal_url_3 = routes.root_url | append: 'pages/data-sharing-opt-out'
  endif
%}

<div
  class="bftr-footer"
  style="--bftr-bg: url({{ bg_url }}); --color-brand-yellow: {{ section.settings.color_brand_yellow }};"
>
  <div class="bftr">
    <div class="bftr-grid">

      <div class="bftr-brand">
        <div class="bftr-logo">
          {% if settings.logo %}
            <img src="{{ settings.logo | image_url: width: 320 }}" alt="{{ settings.logo.alt | default: 'Bronceada' }}" width="160" height="38" style="height:38px;width:auto;filter:brightness(0) invert(1);">
          {% else %}
            <img src="{{ 'BronceadaLogo.png' | asset_url }}" alt="Bronceada" width="160" height="38" style="height:38px;width:auto;filter:brightness(0) invert(1);">
          {% endif %}
        </div>
        <p class="bftr-desc">{{ section.settings.description }}</p>
        <div class="bftr-social">
          {% if section.settings.social_instagram_link != blank %}
            <a href="{{ section.settings.social_instagram_link }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM12 7a5 5 0 1 1 0 10A5 5 0 0 1 12 7zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.social_tiktok_link != blank %}
            <a href="{{ section.settings.social_tiktok_link }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.78a4.84 4.84 0 0 1-1.01-.09z"/></svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div>
        <h4 class="bftr-col-h">{{ section.settings.shop_heading }}</h4>
        <ul class="bftr-links">
          {% if section.settings.shop_link_1_label != blank %}<li><a href="{{ shop_url_1 }}">{{ section.settings.shop_link_1_label }}</a></li>{% endif %}
          {% if section.settings.shop_link_2_label != blank %}<li><a href="{{ shop_url_2 }}">{{ section.settings.shop_link_2_label }}</a></li>{% endif %}
          {% if section.settings.shop_link_3_label != blank %}<li><a href="{{ shop_url_3 }}">{{ section.settings.shop_link_3_label }}</a></li>{% endif %}
          {% if section.settings.shop_link_4_label != blank %}<li><a href="{{ shop_url_4 }}">{{ section.settings.shop_link_4_label }}</a></li>{% endif %}
          {% if section.settings.shop_link_5_label != blank %}<li><a href="{{ shop_url_5 }}">{{ section.settings.shop_link_5_label }}</a></li>{% endif %}
        </ul>
      </div>

      <div>
        <h4 class="bftr-col-h">{{ section.settings.help_heading }}</h4>
        <ul class="bftr-links">
          {% if section.settings.help_link_1_label != blank %}<li><a href="{{ help_url_1 }}">{{ section.settings.help_link_1_label }}</a></li>{% endif %}
          {% if section.settings.help_link_2_label != blank %}<li><a href="{{ help_url_2 }}">{{ section.settings.help_link_2_label }}</a></li>{% endif %}
          {% if section.settings.help_link_3_label != blank %}<li><a href="{{ help_url_3 }}">{{ section.settings.help_link_3_label }}</a></li>{% endif %}
          {% if section.settings.help_link_4_label != blank %}<li><a href="{{ help_url_4 }}">{{ section.settings.help_link_4_label }}</a></li>{% endif %}
        </ul>
      </div>

      <div>
        <h4 class="bftr-col-h">{{ section.settings.visit_heading }}</h4>
        <p class="bftr-address">{{ section.settings.address | newline_to_br }}</p>
        <ul class="bftr-links bftr-links--plain">
          <li>{{ section.settings.hours_line_1 }}</li>
          <li>{{ section.settings.hours_line_2 }}</li>
          <li>{{ section.settings.hours_line_3 }}</li>
        </ul>
      </div>

    </div>

    <div class="bftr-bottom">
      <p class="bftr-copy">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_tagline }}</p>
      <div class="bftr-legal">
        {% if section.settings.legal_link_1_label != blank %}<a href="{{ legal_url_1 }}">{{ section.settings.legal_link_1_label }}</a>{% endif %}
        {% if section.settings.legal_link_2_label != blank %}<a href="{{ legal_url_2 }}">{{ section.settings.legal_link_2_label }}</a>{% endif %}
        {% if section.settings.legal_link_3_label != blank %}<a href="{{ legal_url_3 }}">{{ section.settings.legal_link_3_label }}</a>{% endif %}
      </div>
      <p class="bftr-credit">Designed by <a href="https://phenry.dev" target="_blank" rel="noopener">Phillip Henry</a></p>
    </div>
  </div>
</div>

{% stylesheet %}
  .bftr-footer {
    background-image: var(--bftr-bg);
    background-size: cover;
    background-position: center 60%;
    position: relative;
    color: #ffffff;
    padding: 64px 0 32px;
  }

  .bftr-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 5, 0, 0.78);
    pointer-events: none;
  }

  .bftr {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 28px;
    position: relative;
    z-index: 1;
  }

  .bftr-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .bftr-logo {
    font-family: var(--font-heading--family);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-brand-yellow, #FFEF39);
    margin-bottom: 14px;
  }

  .bftr-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.55);
    max-width: 280px;
    margin-bottom: 22px;
  }

  .bftr-social {
    display: flex;
    gap: 10px;
  }

  .bftr-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.65);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    text-decoration: none;
  }

  .bftr-social a:hover {
    border-color: var(--color-brand-yellow, #FFEF39);
    color: var(--color-brand-yellow, #FFEF39);
    background: rgba(255, 239, 57, 0.08);
  }

  .bftr-social svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .bftr-col-h {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #77F8FF;
    margin-bottom: 18px;
  }

  .bftr-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .bftr-links a {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.2s;
    text-decoration: none;
  }

  .bftr-links a:hover {
    color: #ffffff;
  }

  .bftr-links--plain li {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .bftr-address {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin-bottom: 14px;
  }

  .bftr-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .bftr-copy {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.38);
    margin: 0;
  }

  .bftr-credit {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.38);
    margin: 0;
  }

  .bftr-credit a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .bftr-footer .bftr-credit a:hover {
    color: #c9943a !important;
  }

  .bftr-legal {
    display: flex;
    gap: 22px;
  }

  .bftr-legal a {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.38);
    transition: color 0.2s;
    text-decoration: none;
  }

  .bftr-legal a:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 1100px) {
    .bftr-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .bftr-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .bftr-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "tag": "footer",
  "blocks": [
    { "type": "@app" }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "One-of-a-kind pieces, hand-picked and brought straight to Austin. Find us at Lakeline Mall in Cedar Park, TX."
    },
