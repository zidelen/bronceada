
{% liquid
  assign bg_url = 'lifestyle-beach-banner.jpg' | asset_url
%}

<div
  class="bftr-footer"
  style="--bftr-bg: url({{ bg_url }})"
>
  <div class="bftr">
    <div class="bftr-grid">

      <div class="bftr-brand">
        <div class="bftr-logo">
          <img src="{{ 'BronceadaLogo.png' | asset_url }}" alt="Bronceada" width="160" height="38" style="height:38px;width:auto;filter:brightness(0) invert(1);">
        </div>
        <p class="bftr-desc">One-of-a-kind pieces, hand-picked and brought straight to Austin. Find us at Lakeline Mall in Cedar Park, TX.</p>
        <div class="bftr-social">
          <a href="https://www.instagram.com/shopbronceada" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM12 7a5 5 0 1 1 0 10A5 5 0 0 1 12 7zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@shopbronceada" aria-label="TikTok" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.78a4.84 4.84 0 0 1-1.01-.09z"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="bftr-col-h">Shop</h4>
        <ul class="bftr-links">
          <li><a href="{{ routes.root_url }}collections/new-arrivals">New Arrivals</a></li>
          <li><a href="{{ routes.root_url }}collections/dress-collection">Dresses</a></li>
          <li><a href="{{ routes.root_url }}collections/the-floral-collection">Sets</a></li>
          <li><a href="{{ routes.root_url }}collections/statement-summer-collection">Tops &amp; Basics</a></li>
          <li><a href="{{ routes.root_url }}collections/jewelry-collection">Accessories</a></li>
        </ul>
      </div>

      <div>
        <h4 class="bftr-col-h">Help</h4>
        <ul class="bftr-links">
          <li><a href="{{ routes.root_url }}pages/contact">Contact Us</a></li>
          <li><a href="{{ routes.root_url }}policies/refund-policy">Returns &amp; Exchanges</a></li>
          <li><a href="{{ routes.root_url }}policies/shipping-policy">Shipping Info</a></li>
        </ul>
      </div>

      <div>
        <h4 class="bftr-col-h">Visit Us</h4>
        <p class="bftr-address">UL (Upper Level)<br>Lakeline Mall<br>11200 Lakeline Mall Dr<br>Cedar Park, TX 78613</p>
        <ul class="bftr-links bftr-links--plain">
          <li>Sun &nbsp;12:00pm – 6:00pm</li>
          <li>Mon – Thu &nbsp;11:00am – 8:00pm</li>
          <li>Fri – Sat &nbsp;10:00am – 9:00pm</li>
        </ul>
      </div>

    </div>

    <div class="bftr-bottom">
      <p class="bftr-copy">&copy; {{ 'now' | date: '%Y' }} Bronceada &middot; Boutique &middot; Austin, TX</p>
      <div class="bftr-legal">
        <a href="{{ routes.root_url }}/policies/privacy-policy">Privacy Policy</a>
        <a href="{{ routes.root_url }}/policies/terms-of-service">Terms of Service</a>
        <a href="{{ routes.root_url }}pages/data-sharing-opt-out">Accessibility</a>
      </div>
      <p class="bftr-credit">Designed by <a href="https://phenry.dev" target="_blank" rel="noopener">Phillip Henry</a></p>
    </div>
  </div>
</div>

{% stylesheet %}
  .bftr-footer {
    background-image: var(--bftr-bg);
    background-size: cover;
    background-position: center 60%;
    position: relative;
    color: #ffffff;
    padding: 64px 0 32px;
  }

  .bftr-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 5, 0, 0.78);
    pointer-events: none;
  }

  .bftr {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 28px;
    position: relative;
    z-index: 1;
  }

  .bftr-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .bftr-logo {
    font-family: var(--font-heading--family);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #FFEF39;
    margin-bottom: 14px;
  }

  .bftr-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.55);
    max-width: 280px;
    margin-bottom: 22px;
  }

  .bftr-social {
    display: flex;
    gap: 10px;
  }

  .bftr-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.65);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    text-decoration: none;
  }

  .bftr-social a:hover {
    border-color: #FFEF39;
    color: #FFEF39;
    background: rgba(255, 239, 57, 0.08);
  }

  .bftr-social svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .bftr-col-h {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #77F8FF;
    margin-bottom: 18px;
  }

  .bftr-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .bftr-links a {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.2s;
    text-decoration: none;
  }

  .bftr-links a:hover {
    color: #ffffff;
  }

  .bftr-links--plain li {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .bftr-address {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin-bottom: 14px;
  }

  .bftr-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .bftr-copy {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.38);
    margin: 0;
  }

  .bftr-credit {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.38);
    margin: 0;
  }

  .bftr-credit a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .bftr-footer .bftr-credit a:hover {
    color: #c9943a !important;
  }

  .bftr-legal {
    display: flex;
    gap: 22px;
  }

  .bftr-legal a {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.38);
    transition: color 0.2s;
    text-decoration: none;
  }

  .bftr-legal a:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 1100px) {
    .bftr-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .bftr-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .bftr-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "tag": "footer",
  "blocks": [
    { "type": "@app" }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": []
}
{% endschema %}
