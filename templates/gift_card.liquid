{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'stylesheets' -%}
    {{ 'template-giftcard.css' | asset_url | stylesheet_tag }}

    <script type="importmap">
      {
        "imports": {
          "@theme/component": "{{ 'component.js' | asset_url }}",
          "@theme/utilities": "{{ 'utilities.js' | asset_url }}",
          "@theme/qr-code-generator": "{{ 'qr-code-generator.js' | asset_url }}"
        }
      }
    </script>

    <script
      src="{{ 'qr-code-image.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
    <script
      src="{{ 'copy-to-clipboard.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_schemes.scheme-1.settings.background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/png" href="{{ 'BronceadaFavicon.png' | asset_url }}">

    {%- assign formatted_balance = gift_card.balance | money_without_trailing_zeros | strip_html -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_balance, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">

    {{ content_for_header }}

    {% # theme-check-disable AssetPreload %}
    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin fetchpriority="low">
    {%- endunless -%}
    {%- unless settings.type_subheading_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_subheading_font | font_url }}" type="font/woff2" crossorigin fetchpriority="low">
    {%- endunless -%}
    {%- unless settings.type_heading_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_heading_font | font_url }}" type="font/woff2" crossorigin fetchpriority="low">
    {%- endunless -%}
    {%- unless settings.type_accent_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_accent_font | font_url }}" type="font/woff2" crossorigin fetchpriority="low">
    {%- endunless -%}
    {% # theme-check-enable AssetPreload %}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}
  </head>

  <body class="gc-page">

    <div class="gc-bg" aria-hidden="true">
      <div class="gc-bg__orb gc-bg__orb--1"></div>
      <div class="gc-bg__orb gc-bg__orb--2"></div>
    </div>

    <main class="gc-wrap">

      <!-- Physical gift card -->
      <div class="gc-card">
        <div class="gc-card__shine" aria-hidden="true"></div>
        <div class="gc-card__circles" aria-hidden="true">
          <span class="gc-card__circle gc-card__circle--a"></span>
          <span class="gc-card__circle gc-card__circle--b"></span>
        </div>
        <div class="gc-card__top">
          {%- if settings.logo != blank -%}
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {{ settings.logo | image_url: width: 200 | image_tag: class: 'gc-card__logo', alt: logo_alt }}
          {%- else -%}
            <span class="gc-card__shop-name">{{ shop.name }}</span>
          {%- endif -%}
        </div>
        <div class="gc-card__bottom">
          <span class="gc-card__label">Gift Card</span>
          <span class="gc-card__amount">{{ gift_card.balance | money_with_currency }}</span>
        </div>
      </div>

      <!-- Content panel -->
      <div class="gc-panel">

        <!-- Balance -->
        <div class="gc-panel__balance">
          <p class="gc-panel__balance-eyebrow">Your balance</p>
          <p class="gc-panel__balance-amount">{{ gift_card.balance | money_with_currency }}</p>
          {%- if gift_card.enabled == false or gift_card.expired -%}
            <span class="gc-badge--expired">{{ 'gift_cards.issued.expired' | t }}</span>
          {%- endif -%}
          {%- if gift_card.expires_on -%}
            {%- assign gift_card_expiration_date = gift_card.expires_on | date: '%B %e, %Y' -%}
            <p class="gc-panel__expiry">{{ 'gift_cards.issued.expiration_date' | t: expires_on: gift_card_expiration_date }}</p>
          {%- endif -%}
        </div>

        <div class="gc-divider" aria-hidden="true"></div>

        <!-- Code -->
        <div class="gc-panel__code-section">
          <p class="gc-panel__code-label">{{ 'gift_cards.issued.how_to_use_gift_card' | t }}</p>
          <copy-to-clipboard-component class="gc-pill-copy" text-to-copy="{{ gift_card.code }}">
            <span class="form__message visually-hidden" ref="copySuccessMessage" role="status">
              <span class="svg-wrapper icon-success">
                {{ 'icon-checkmark.svg' | inline_asset_content }}
              </span>
              {{ 'gift_cards.issued.copy_code_success' | t }}
            </span>
            <div class="gc-panel__code-pill" on:click="/copyToClipboard" title="{{ 'gift_cards.issued.copy_code' | t }}">
              <span class="gc-panel__code">{{ gift_card.code | format_code }}</span>
              <span class="gc-pill-copy__icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </span>
            </div>
          </copy-to-clipboard-component>
        </div>

        <!-- QR code -->
        <qr-code-image
          class="gc-qr"
          data-identifier="{{ gift_card.qr_identifier }}"
          width="88"
          height="88"
          alt="{{ 'gift_cards.issued.qr_image_alt' | t }}"
        ></qr-code-image>

        <!-- Actions -->
        <div class="gc-actions">
          {%- if gift_card.pass_url -%}
            <a href="{{ gift_card.pass_url }}" class="gc-actions__wallet">
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                width="120"
                height="40"
                alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
                loading="lazy"
              >
            </a>
          {%- endif -%}

          <copy-to-clipboard-component class="gc-actions__copy-wrap" text-to-copy="{{ gift_card.code }}">
            <span class="form__message visually-hidden" ref="copySuccessMessage" role="status">
              <span class="svg-wrapper icon-success">
                {{ 'icon-checkmark.svg' | inline_asset_content }}
              </span>
              {{ 'gift_cards.issued.copy_code_success' | t }}
            </span>
            <button class="gc-btn gc-btn--primary" on:click="/copyToClipboard">
              {{ 'gift_cards.issued.copy_code' | t }}
            </button>
          </copy-to-clipboard-component>

          <a
            href="{{ shop.url }}"
            class="gc-btn gc-btn--secondary"
            target="_blank"
            rel="noopener"
            aria-describedby="a11y-new-window-message"
          >
            {{ 'gift_cards.issued.shop_link' | t }}
          </a>
        </div>

      </div>
    </main>

    <div hidden>
      <span id="a11y-new-window-message">{{ 'accessibility.new_window' | t }}</span>
    </div>
  </body>
</html>
