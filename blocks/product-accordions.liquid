{%- assign sizing_info = closest.product.metafields.custom.sizing_info -%}

<div class="brn-acc">

  {%- if sizing_info != blank -%}
  <div class="brn-acc__item">
    <button class="brn-acc__trigger" aria-expanded="false" aria-controls="brn-acc-sizing-{{ block.id }}">
      <span>Details + Sizing</span>
      <svg class="brn-acc__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="brn-acc__panel" id="brn-acc-sizing-{{ block.id }}" hidden>
      <div class="brn-acc__content">
        {{ sizing_info | metafield_tag }}
      </div>
    </div>
  </div>
  {%- endif -%}

  <div class="brn-acc__item">
    <button class="brn-acc__trigger" aria-expanded="false" aria-controls="brn-acc-shipping-{{ block.id }}">
      <span>Shipping + Returns</span>
      <svg class="brn-acc__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="brn-acc__panel" id="brn-acc-shipping-{{ block.id }}" hidden>
      <div class="brn-acc__content">
        <p>Orders ship within <strong>1–3 business days</strong>. Standard delivery takes 3–7 business days within the US.</p>
        <p>We accept returns for <strong>store credit only</strong> within 14 days of purchase or delivery. Items must be unworn, unwashed, and have all tags attached.</p>
        <p>Final sale items, accessories, jewelry, and swimwear cannot be returned.</p>
        <div class="brn-acc__policy-links">
          See full policy:
          <a href="{{ routes.root_url }}pages/shipping">Shipping</a>
          <span aria-hidden="true">&middot;</span>
          <a href="{{ routes.root_url }}pages/refunds">Returns</a>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  (function() {
    var triggers = document.querySelectorAll('#brn-acc-sizing-{{ block.id }}, #brn-acc-shipping-{{ block.id }}');
    document.querySelectorAll('[aria-controls="brn-acc-sizing-{{ block.id }}"], [aria-controls="brn-acc-shipping-{{ block.id }}"]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var expanded = this.getAttribute('aria-expanded') === 'true';
        var panel = document.getElementById(this.getAttribute('aria-controls'));
        this.setAttribute('aria-expanded', String(!expanded));
        panel.hidden = expanded;
      });
    });
  })();
</script>

{% stylesheet %}

  .brn-acc {
    border-top: 1px solid rgba(17, 17, 17, 0.12);
    width: 100%;
  }

  .brn-acc__item {
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
  }

  .brn-acc__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    padding: 18px 0;
    cursor: pointer;
    text-align: left;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #111;
  }

  .brn-acc__trigger:hover {
    color: #0A9CB5;
  }

  .brn-acc__chevron {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .brn-acc__trigger[aria-expanded="true"] .brn-acc__chevron {
    transform: rotate(180deg);
  }

  .brn-acc__panel[hidden] {
    display: none;
  }

  .brn-acc__content {
    padding: 0 0 20px;
    font-size: 0.88rem;
    line-height: 1.72;
    color: rgba(17, 17, 17, 0.65);
  }

  .brn-acc__content p {
    margin: 0 0 0.75em;
  }

  .brn-acc__content p:last-child {
    margin-bottom: 0;
  }

  .brn-acc__policy-links {
    margin-top: 12px;
    font-size: 0.82rem;
    color: rgba(17, 17, 17, 0.5);
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .brn-acc__policy-links a {
    color: #0A9CB5;
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
  }

  .brn-acc__policy-links a:hover {
    color: #111;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Product Accordions",
  "tag": null,
  "settings": []
}
{% endschema %}
